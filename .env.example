# ─────────────────────────────────────────────────────────────────────────────
# cercatrova-front — variables de entorno
#
# Copiá este archivo a `.env` y completá los valores.
#
# ⚠️ Las variables `NEXT_PUBLIC_*` se hornean en el bundle en tiempo de BUILD,
#    no se leen en runtime. Cambiar una exige volver a buildear: reiniciar el
#    servidor no alcanza. Y como viajan al navegador, NO pongas secretos acá.
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend NestJS (sin barra final).
# OBLIGATORIA: si falta, `next build` falla con un error explícito
# (ver src/modules/shared/lib/env.ts). En desarrollo, si no está definida,
# se usa http://localhost:3000 con un warning en consola.
#   dev  → http://localhost:3000
#   prod → https://api.tu-dominio.com
NEXT_PUBLIC_API_URL=

# Client ID de Google Identity Services, para "Continuar con Google".
# OPCIONAL: si falta, el login con email + contraseña sigue funcionando y el
# botón de Google simplemente no se renderiza. Tiene que ser el MISMO Client ID
# que usa el backend en su GOOGLE_CLIENT_ID, o el token se rechaza con 401
# ("El token no fue emitido para esta aplicación").
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Solo build/tooling (no van al bundle)
# ─────────────────────────────────────────────────────────────────────────────

# Directorio de salida del build. Sirve en Windows para buildear sin pelear
# con el `.next` que bloquea el dev server:
#   NEXT_DIST_DIR=.next-build npm run build
# Sin definir, el comportamiento es el de siempre (`.next`).
# NEXT_DIST_DIR=
